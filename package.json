{
  "name": "deepseek-harness-launcher",
  "version": "0.1.0",
  "description": "Lightweight unofficial native Windows launcher for the DeepSeek Harness Web UI",
  "author": "DeepSeek Harness Launcher contributors",
  "license": "MIT",
  "scripts": {
    "install-desktop": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall-desktop": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1",
    "start": "powershell -ExecutionPolicy Bypass -File scripts/launch.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "diagnose": "powershell -ExecutionPolicy Bypass -File scripts/diagnose.ps1",
    "build:icon": "python scripts/build_icon.py",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/verify.ps1 -Behavior"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "desktop-launcher",
    "windows-shortcut",
    "agent",
    "llm"
  ]
}
